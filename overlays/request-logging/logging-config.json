{
  "version": 1,
  "disable_existing_loggers": false,

  "formatters": {
    "vllm": {
      "class": "vllm.logging_utils.NewLineFormatter",
      "datefmt": "%m-%d %H:%M:%S",
      "format": "%(levelname)s %(asctime)s [%(fileinfo)s:%(lineno)d] %(message)s"
    },
    "capture": {
      "datefmt": "%Y-%m-%dT%H:%M:%S",
      "format": "%(asctime)s %(message)s"
    }
  },

  "handlers": {
    "vllm": {
      "class": "logging.StreamHandler",
      "formatter": "vllm",
      "level": "DEBUG",
      "stream": "ext://sys.stdout"
    },
    "capture_file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "capture",
      "level": "DEBUG",
      "filename": "/var/log/vllm/requests/requests.log",
      "when": "H",
      "interval": 1,
      "backupCount": 168,
      "encoding": "utf-8",
      "delay": true
    }
  },

  "loggers": {
    "vllm": {
      "handlers": ["vllm"],
      "level": "INFO",
      "propagate": false
    },

    "vllm.entrypoints.logger": {
      "handlers": ["vllm", "capture_file"],
      "level": "DEBUG",
      "propagate": false
    },
    "vllm.entrypoints.request_logger": {
      "handlers": ["vllm", "capture_file"],
      "level": "DEBUG",
      "propagate": false
    },
    "vllm.entrypoints.serve.utils.request_logger": {
      "handlers": ["vllm", "capture_file"],
      "level": "DEBUG",
      "propagate": false
    }
  }
}
