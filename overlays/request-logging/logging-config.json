{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "vllm": {
      "class": "vllm.logging_utils.NewLineFormatter",
      "datefmt": "%m-%d %H:%M:%S",
      "format": "%(levelname)s %(asctime)s [%(fileinfo)s:%(lineno)d] %(message)s"
    },
    "capture": {
      "datefmt": "%Y-%m-%dT%H:%M:%S",
      "format": "%(asctime)s %(message)s"
    }
  },
  "handlers": {
    "vllm": {
      "class": "logging.StreamHandler",
      "formatter": "vllm",
      "level": "DEBUG",
      "stream": "ext://sys.stdout"
    },
    "capture_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "capture",
      "level": "DEBUG",
      "filename": "/var/log/vllm/requests.log",
      "maxBytes": 134217728,
      "backupCount": 40,
      "encoding": "utf-8",
      "delay": true
    }
  },
  "loggers": {
    "vllm": {
      "handlers": [
        "vllm"
      ],
      "level": "INFO",
      "propagate": false
    },
    "vllm.entrypoints.logger": {
      "handlers": [
        "capture_file"
      ],
      "level": "DEBUG",
      "propagate": false
    },
    "vllm.entrypoints.request_logger": {
      "handlers": [
        "capture_file"
      ],
      "level": "DEBUG",
      "propagate": false
    },
    "vllm.entrypoints.serve.utils.request_logger": {
      "handlers": [
        "capture_file"
      ],
      "level": "DEBUG",
      "propagate": false
    },
    "uvicorn": {
      "handlers": [
        "vllm"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": [
        "vllm"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [
        "vllm"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}
